"""
ระบบแนะนำการออกกำลังกายรายสัปดาห์ด้วย A* Search
------------------------------------------------
Input  : อายุ, น้ำหนัก, ส่วนสูง, โรคประจำตัว, แคลอรี่ที่ต้องการเผาผลาญต่อสัปดาห์
Output : ตารางออกกำลังกาย 7 วัน (มีวันพัก) ที่เผาผลาญถึงเป้าหมาย
         โดย "ออกกำลังกายหนักน้อยที่สุด" ตามฟังก์ชันต้นทุน (cost)

แนวคิด A*
  - State  : (วันที่, แคลที่เผาแล้ว, จำนวนวันติดกัน, session เมื่อวาน, จำนวนวันที่ออกกำลังกายแล้ว)
  - Action : พัก  หรือ  เลือก session (ชุดท่า 2-3 ท่า) 1 ชุดสำหรับวันนั้น
  - g(n)   : ต้นทุนสะสม (ความเหนื่อย + ความเสี่ยง + จำนวนวันที่ออก)
  - h(n)   : แคลที่ยังขาด x (ต้นทุนต่อ 1 kcal ที่ต่ำที่สุดของทุก session)
             -> เป็น admissible heuristic (ไม่เกินต้นทุนจริงแน่นอน)
  - Goal   : แคลที่เผาแล้ว >= เป้าหมาย
"""

import heapq
import itertools
from dataclasses import dataclass


# ======================================================================
# 1) ฐานข้อมูลท่าออกกำลังกาย
# ======================================================================
@dataclass
class Exercise:
    name: str           # ชื่อท่า
    muscle_text: str    # ส่วนกล้ามเนื้อ (แสดงผล)
    muscles: tuple      # ส่วนกล้ามเนื้อ (ใช้ตรวจสอบการพัก)
    sets: int           # จำนวนเซ็ตมาตรฐาน
    reps: str           # ครั้ง/เวลาต่อเซ็ต
    kcal_per_set: float
    note: str           # ข้อควรระวังจากตาราง
    forbidden: tuple = ()   # โรค/อาการที่ "ห้าม" ทำท่านี้
    caution: tuple = ()     # โรค/อาการที่ "ทำได้แต่ต้องลดปริมาณ"


