# โรค/อาการที่ให้ผู้ใช้เลือก (รหัส -> ชื่อภาษาไทย)
CONDITIONS = {
    "ankle": "ปัญหาข้อเท้า",
    "bone": "กระดูกเปราะ/กระดูกพรุน",
    "knee": "ปวดเข่า/ข้อเข่าเสื่อม",
    "wrist": "เจ็บข้อมือ",
    "hypertension": "ความดันโลหิตสูง",
    "back": "ปวดหลังส่วนล่าง",
    "shoulder": "เจ็บไหล่",
    "neck": "ปวดคอ",
    "heart": "โรคหัวใจ",
    "diabetes": "เบาหวาน",
    "disc": "หมอนรองกระดูกทับเส้น",
}

# พารามิเตอร์ตามช่วงอายุ: (วันออกกำลังกายสูงสุด/สัปดาห์, ออกติดกันได้สูงสุด(วัน),
#                         แคลสูงสุดต่อวัน, น้ำหนักอ้างอิง(กก.))
AGE_PARAMS = {
    "7-13": (3, 1, 40, 40),
    "14-19": (4, 2, 60, 55),
    "20-39": (5, 2, 100, 65),
    "40-59": (4, 1, 45, 65),
}

DAY_NAMES = ["จันทร์", "อังคาร", "พุธ", "พฤหัสบดี", "ศุกร์", "เสาร์", "อาทิตย์"]

# ค่าถ่วงน้ำหนักของฟังก์ชันต้นทุน (ปรับได้)
DAY_COST = 10.0          # ต้นทุนคงที่ของการออกกำลังกาย 1 วัน
KCAL_COST = 0.05         # ต้นทุนต่อ 1 kcal
FATIGUE_COST = 20.0      # ต้นทุนความเหนื่อย (ยิ่งใกล้เพดานแคลต่อวันยิ่งแพง)
CAUTION_COST = 2.0       # ต้นทุนต่อท่าที่ต้องระวัง
CONSEC_PENALTY = 3.0     # ลงโทษการออกกำลังกายติดกันหลายวัน
REST_COST = 0.01         # ต้นทุนเล็กน้อยของวันพัก (ให้เริ่มออกกำลังกายเร็ว ไม่พักโดยไม่จำเป็น)


# ======================================================================
# 2) เตรียมข้อมูลผู้ใช้
# ======================================================================
def get_age_group(age):
    if age <= 13:
        return "7-13"
    if age <= 19:
        return "14-19"
    if age <= 39:
        return "20-39"
    return "40-59"      # 60 ปีขึ้นไปใช้กลุ่มนี้ (พร้อมคำเตือน)


def calc_limits(age, bmi, conds):
    """คำนวณข้อจำกัดด้วยกฎ (heuristic rules) ตามอายุ โรค และ BMI"""
    group = get_age_group(age)
    max_days, max_consec, cap, ref_weight = AGE_PARAMS[group]

    # โรคที่เสี่ยงต่อระบบหัวใจ/เมตาบอลิซึม -> ลดจำนวนวันและความหนักต่อวัน
    if {"heart", "hypertension", "diabetes"} & set(conds):
        max_days = max(2, max_days - 1)
        cap *= 0.8
    # อายุ 60+ ลดเพิ่ม
    if age >= 60:
        max_days = max(2, max_days - 1)
        cap *= 0.8
    # BMI >= 30 (ผู้ใหญ่) -> ลดความหนัก และไม่ให้ออกติดกัน
    if age >= 18 and bmi >= 30:
        cap *= 0.85
        max_consec = 1
    return group, max_days, max_consec, cap, ref_weight


@dataclass
class Session:
    """ชุดท่าออกกำลังกายใน 1 วัน"""
    items: list         # [(Exercise, จำนวนเซ็ตที่ใช้, kcal)]
    kcal: float
    muscles: set
    n_caution: int
    cost: float


def build_sessions(group, conds, weight, ref_weight, cap):
    """สร้างชุดท่าที่เป็นไปได้ทั้งหมด (เลือกเฉพาะท่าที่ปลอดภัย)"""
    factor = min(1.4, max(0.7, weight / ref_weight))   # ปรับแคลตามน้ำหนักตัว
    safe = []
    for ex in EXERCISES[group]:
        if set(ex.forbidden) & set(conds):
            continue                                    # ห้ามทำ -> ตัดทิ้ง
        sets = ex.sets
        caution = bool(set(ex.caution) & set(conds))
        if caution:
            sets = max(1, sets - 1)                     # ต้องระวัง -> ลด 1 เซ็ต
        safe.append((ex, sets, ex.kcal_per_set * sets * factor, caution))

    if not safe:
        return [], []

    sizes = [2, 3] if len(safe) >= 3 else list(range(1, len(safe) + 1))
    sessions = []
    for size in sizes:
        for combo in itertools.combinations(safe, size):
            kcal = sum(c[2] for c in combo)
            if kcal > cap:
                continue                                # หนักเกินเพดานต่อวัน
            n_caution = sum(1 for c in combo if c[3])
            muscles = set()
            for c in combo:
                muscles |= set(c[0].muscles)
            cost = (DAY_COST + KCAL_COST * kcal
                    + FATIGUE_COST * (kcal / cap) ** 2
                    + CAUTION_COST * n_caution)
            sessions.append(Session([(c[0], c[1], c[2]) for c in combo],
                                    kcal, muscles, n_caution, cost))
    return sessions, safe


# ======================================================================
# 3) A* Search
# ======================================================================
def astar_plan(sessions, target, max_days, max_consec):
    """
    คืนค่า (plan, nodes_expanded)
    plan = list ยาว 7 ช่อง  ค่า -1 = พัก, ค่าอื่น = index ของ session
    """
    # Heuristic: ต้นทุนต่อ kcal ที่ถูกที่สุด -> admissible
    c_min = min(s.cost / s.kcal for s in sessions)
    max_kcal = max(s.kcal for s in sessions)

    def h(burned):
        return max(0.0, target - burned) * c_min

    counter = itertools.count()     # ใช้ตัดสินเมื่อ f เท่ากัน
    # node = (f, tie, g, day, burned, consec, last, used, plan)
    start = (h(0), next(counter), 0.0, 0, 0.0, 0, -1, 0, ())
    open_list = [start]
    closed = set()
    expanded = 0

    while open_list:
        f, _, g, day, burned, consec, last, used, plan = heapq.heappop(open_list)

        # ตรวจ Goal
        if burned >= target - 1e-9:
            plan = list(plan) + [-1] * (7 - len(plan))   # วันที่เหลือเป็นวันพัก
            return plan, expanded

        key = (day, round(burned, 1), consec, last, used)
        if key in closed:
            continue
        closed.add(key)
        expanded += 1

        if day >= 7:
            continue

        # --- Action 1: พัก ---
        new_g = g + REST_COST
        heapq.heappush(open_list, (new_g + h(burned), next(counter), new_g,
                                   day + 1, burned, 0, -1, used, plan + (-1,)))

        # --- Action 2: ออกกำลังกาย ---
        if used >= max_days or consec >= max_consec:
            continue
        for idx, s in enumerate(sessions):
            # กฎการพักกล้ามเนื้อ: ห้ามใช้กล้ามเนื้อกลุ่มเดิมติดกัน (ยกเว้นคาร์ดิโอ)
            if consec > 0 and last >= 0:
                overlap = (s.muscles & sessions[last].muscles) - {"cardio"}
                if overlap:
                    continue
            new_burned = burned + s.kcal
            # ตัดทิ้งถ้าต่อให้ออกเต็มที่ก็ไม่ถึงเป้า
            if target - new_burned > (max_days - used - 1) * max_kcal:
                continue
            step = s.cost + (CONSEC_PENALTY if consec > 0 else 0.0)
            new_g = g + step
            heapq.heappush(open_list, (new_g + h(new_burned), next(counter), new_g,
                                       day + 1, new_burned, consec + 1, idx,
                                       used + 1, plan + (idx,)))
    return None, expanded


# ======================================================================
# 4) รับ input / แสดงผล
# ======================================================================
def read_number(prompt, low, high):
    while True:
        try:
            value = float(input(prompt))
            if low <= value <= high:
                return value
            print(f"  กรุณากรอกค่าระหว่าง {low} - {high}")
        except ValueError:
            print("  กรุณากรอกตัวเลข")


def read_conditions():
    keys = list(CONDITIONS.keys())
    print("\nโรคประจำตัว/อาการบาดเจ็บ (เลือกได้หลายข้อ คั่นด้วยจุลภาค เช่น 1,3 | กด Enter หรือ 0 = ไม่มี)")
    for i, k in enumerate(keys, 1):
        print(f"  {i}. {CONDITIONS[k]}")
    while True:
        text = input("เลือก: ").strip()
        if text in ("", "0"):
            return []
        try:
            nums = [int(x) for x in text.split(",")]
            if all(1 <= n <= len(keys) for n in nums):
                return [keys[n - 1] for n in sorted(set(nums))]
        except ValueError:
            pass
        print("  รูปแบบไม่ถูกต้อง ลองใหม่อีกครั้ง")


def show_plan(plan, sessions, target, achieved, nodes):
    print("\n" + "=" * 62)
    print("                 แผนออกกำลังกาย 1 สัปดาห์")
    print("=" * 62)
    for d, idx in enumerate(plan):
        if idx == -1:
            print(f"\nวัน{DAY_NAMES[d]}: 😴 วันพัก")
            continue
        s = sessions[idx]
        print(f"\nวัน{DAY_NAMES[d]}: 💪 ออกกำลังกาย (รวม ~{s.kcal:.1f} kcal)")
        for ex, sets, kcal in s.items:
            warn = "  [ลดเซ็ตเพราะข้อควรระวัง]" if sets < ex.sets else ""
            print(f"   - {ex.name} ({ex.muscle_text}): {sets} เซ็ต x {ex.reps}"
                  f"  ~{kcal:.1f} kcal{warn}")
            print(f"       หมายเหตุ: {ex.note}")
    work_days = sum(1 for p in plan if p != -1)
    print("\n" + "-" * 62)
    print(f"วันออกกำลังกาย {work_days} วัน | วันพัก {7 - work_days} วัน")
    print(f"แคลที่ต้องการ {target:.0f} kcal | แผนนี้เผาผลาญ ~{achieved:.1f} kcal")
    print(f"(A* ขยาย node ทั้งหมด {nodes} node)")


def main():
    print("=== ระบบแนะนำการออกกำลังกาย (A* Search) ===\n")
    age = int(read_number("อายุ (ปี): ", 7, 100))
    weight = read_number("น้ำหนัก (กก.): ", 15, 250)
    height = read_number("ส่วนสูง (ซม.): ", 100, 250)
    conds = read_conditions()
    target = read_number("\nแคลอรี่ที่ต้องการเผาผลาญจากการออกกำลังกายต่อสัปดาห์ (kcal): ", 1, 5000)

    bmi = weight / (height / 100) ** 2
    group, max_days, max_consec, cap, ref_w = calc_limits(age, bmi, conds)

    print(f"\nBMI = {bmi:.1f} | ใช้ท่าของช่วงอายุ {group} ปี")
    if age >= 60:
        print("⚠ อายุ 60 ปีขึ้นไป: ใช้ท่ากลุ่ม 40-59 และลดความหนักลง ควรปรึกษาแพทย์")
    if "heart" in conds or "hypertension" in conds:
        print("⚠ มีโรคหัวใจ/ความดันสูง: ควรปรึกษาแพทย์ก่อนเริ่มออกกำลังกาย")
    print(f"เงื่อนไขของระบบ: ออกกำลังกายได้ไม่เกิน {max_days} วัน/สัปดาห์, "
          f"ติดกันไม่เกิน {max_consec} วัน, ไม่เกิน {cap:.0f} kcal/วัน")

    sessions, safe = build_sessions(group, conds, weight, ref_w, cap)
    if not sessions:
        print("\nไม่มีท่าที่ปลอดภัยสำหรับเงื่อนไขของคุณ กรุณาปรึกษาแพทย์/ผู้เชี่ยวชาญ")
        return
    print("ท่าที่ปลอดภัยสำหรับคุณ:", ", ".join(s[0].name for s in safe))

    # ถ้าเป้าหมายสูงเกินที่ปลอดภัย ให้ลดเป้าทีละ 5% จนกว่าจะหาแผนได้
    goal = float(target)
    plan, nodes = astar_plan(sessions, goal, max_days, max_consec)
    while plan is None:
        goal *= 0.95
        plan, nodes = astar_plan(sessions, goal, max_days, max_consec)
    if goal < target:
        print(f"\n⚠ เป้าหมาย {target:.0f} kcal สูงเกินกว่าจะทำได้อย่างปลอดภัย"
              f" -> ปรับเป็น {goal:.0f} kcal/สัปดาห์")

    achieved = sum(sessions[i].kcal for i in plan if i != -1)
    show_plan(plan, sessions, goal, achieved, nodes)
    print("\n* ข้อมูลนี้เป็นคำแนะนำเบื้องต้น ไม่ใช่คำแนะนำทางการแพทย์")


if __name__ == "__main__":
    main()
